# === Required: Claude (Anthropic) API key ===
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Model used by the agent for planning + extraction.
# Options: claude-opus-5 (deepest), claude-sonnet-5 (balanced, default), claude-haiku-4-5-20251001 (fast/cheap)
AGENT_MODEL=claude-sonnet-5

# === Search provider ===
# "ddgs"   -> free, no key required (default)
# "tavily" -> higher quality, requires TAVILY_API_KEY (https://tavily.com)
SEARCH_PROVIDER=ddgs
TAVILY_API_KEY=

# === Run tuning ===
# Max tools to fully research (screenshots + extraction) in one run.
MAX_TOOLS=25
# Search results to pull per query.
RESULTS_PER_QUERY=8
# Headless browser (true recommended; set false to watch it work).
HEADLESS=true
# Seconds to wait for a page before giving up.
PAGE_TIMEOUT=30
